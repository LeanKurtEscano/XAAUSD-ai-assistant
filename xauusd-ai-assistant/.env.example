# Optional full path to your existing terminal64.exe. Leave blank to use the default MT5 installation.
MT5_TERMINAL_PATH=
# Use the exact broker symbol if it is not plain XAUUSD (for example XAUUSD.a).
MT5_SYMBOL=XAUUSD

# Telegram credentials from BotFather and your personal chat ID.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TIMEFRAME_ENTRY=M5
TIMEFRAME_TREND=M15
EMA_FAST=20
EMA_SLOW=50
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
MIN_REWARD_RISK=1.5
# Spread is measured in raw price units (ask - bid), not points.
MAX_SPREAD=0.50
MONITOR_INTERVAL_SECONDS=15
CANDLE_HISTORY=250
MAX_CANDLE_AGE_MINUTES=10
ENABLE_STATUS_ALERTS=false
LOG_LEVEL=INFO
# Maximum distance from EMA20 for the previous candle's pullback, expressed as a fraction of ATR.
PULLBACK_ATR_TOLERANCE=0.25
